spring.application.name=tracker

# PostgreSQL — defaults match docker-compose.yml
spring.datasource.url=jdbc:postgresql://localhost:5432/expense_tracker
spring.datasource.username=postgres
spring.datasource.password=postgres

spring.datasource.driver-class-name=org.postgresql.Driver
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Flyway
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

# JWT — generate a real secret: openssl rand -base64 32
jwt.secret=CHANGE_ME
jwt.expiration-ms=900000

# Mail — required (the app will not start without a mail host).
# Defaults point at the Mailpit container from docker-compose.yml; open http://localhost:8025 to read emails.
spring.mail.host=localhost
spring.mail.port=1025
app.base-url=http://localhost:8080

# Actuator — only expose health check
management.endpoints.web.exposure.include=health
management.endpoint.health.show-details=never